#include <iostream>

int main() {
    // Задаємо значення
    long long N = 34; // Загальна кількість книг
    long long K = 6;  // Місткість однієї полиці
    std::cout << "Задані значення: всього книг (N) = " << N 
              << ", місткість полиці (K) = " << K << "\n\n";
    long long full_shelves = N / K;
    // Остача від ділення (%) знаходить кількість книг на неповній полиці
    long long leftover_books = N % K;
    // Результат
    std::cout << "Повністю заповнених полиць: " << full_shelves << std::endl;
    std::cout << "Книг на неповній полиці: " << leftover_books << std::endl;
    return 0;
}
